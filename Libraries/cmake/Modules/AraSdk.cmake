set(CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
set(ARA_SDK_TARGET_LINK_OPTS)

include(AraSdkConfigure)
include(AraSdkMacros)
include(GeneralSettings)
include(VisualStudioSettings)
include(CMakeRC)

include(GLBaseDepInclude)
include(GLBaseDependencies)
include(GLBaseCopyDependencies)
include(Gtk3Include)
include(ResCompInclude)
include(PugiXMLInclude)
include(UIDepInclude)
include(UtilitiesDepInclude)
include(UtilitiesDependencies)
include(UtilitiesCopyDependencies)
include(OpenCV)

if (ARA_USE_CMRC AND NOT ${CMAKE_BUILD_TYPE} MATCHES Debug OR ANDROID)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_CMRC)
endif()
if (ARA_USE_CLIP)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_CLIP)
endif()
if (ARA_USE_CURL)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_CURL)
endif()
if (ARA_USE_EGL)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_EGL)
endif()
if (ARA_USE_GLFW AND NOT COMPILE_SCENEGRAPH_LIB_NO_GLFW)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_GLFW)
endif()
if (ARA_USE_GLES31)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_GLES31)
endif()
if (ARA_USE_FREEIMAGE)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_FREEIMAGE)
endif ()
if (ARA_USE_OSMESA)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_OSMESA)
endif ()
if (ARA_USE_OPENCV)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_OPENCV)
    if(WIN32)
        set(OpenCV_DIR ${CMAKE_SOURCE_DIR}/Libraries/third_party/opencv/x64/vc16/lib)
    endif ()
endif()
if (ARA_USE_NLOHMANN_JSON)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_NLOHMANN_JSON)
endif()
if (${ARA_ANDROID_PURE_NATIVE_APP})
    append_unique(ara_sdk_COMPILE_DEFINITIONS  ARA_ANDROID_PURE_NATIVE_APP)
endif()

set(COMPILE_SCENEGRAPH_LIB OFF)           # standalone compilation of UI Framework
set(COMPILE_SCENEGRAPH_LIB_NO_GLFW OFF)   # compile without glfw
set(COMPILE_SCENEGRAPH_LIB_STATIC OFF)    # compile with MTd / MT switch for windows

if (COMPILE_SCENEGRAPH_LIB OR ARA_USE_GLBASE)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_USE_GLBASE)
endif ()

if (${CMAKE_BUILD_TYPE} MATCHES Debug)
    append_unique(ara_sdk_COMPILE_DEFINITIONS ARA_DEBUG)
endif()
